{
  "name": "gsp-rag-cap-auna-dev",
  "version": "1.0.0",
  "description": "CAP Backend RAG DEV",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap/cds": "^8",
    "@sap/cds-dk": "^8",
    "@sap/hana-client": "^2",
    "axios": "^1",
    "cap-llm-plugin": "^1",
    "express": "^4",
    "uuid": "^9"
  },
  "devDependencies": { "@cap-js/sqlite": "^1" },
  "scripts": { "start": "cds-serve", "dev": "cds watch", "build": "cds build --production" },
  "cds": {
    "hana": { "deploy-format": "hdbtable" },
    "requires": {
      "db": { "kind": "hana" },
      "auth": "dummy",
      "cap-llm-plugin": { "impl": "cap-llm-plugin" }
    },
    "features": { "vector_support": true }
  }
}
